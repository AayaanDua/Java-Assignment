public class Q1 {

    static <T extends Number> double sum(T[] numbers) {
        double total = 0;
        for (T n : numbers) {
            total += n.doubleValue();
        }
        return total;
    }

    public static void main(String[] args) {
        Integer[] ints = {10, 20, 30, 40};
        Float[] floats = {1.5f, 2.5f, 3.25f};
        Double[] doubles = {10.75, 20.5, 30.125};

        System.out.println("Sum of integers: " + sum(ints));
        System.out.println("Sum of floats: " + sum(floats));
        System.out.println("Sum of doubles: " + sum(doubles));
    }
}
